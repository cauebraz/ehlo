{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "ehlo-pipeline"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "enable": true,
          "hide": false,
          "iconColor": "red",
          "legacyOptions": {
            "expr": "ALERTS{component=\"ehlo\", alertstate=\"firing\", severity!=\"info\"}",
            "step": "15s",
            "textFormat": "{{source}} {{provider}} {{code}}",
            "titleFormat": "{{alertname}}",
            "useValueForTime": false
          },
          "name": "Alerts",
          "query": {
            "datasource": {
              "name": "${datasource}"
            },
            "group": "prometheus",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "Are events still arriving? A silent feed looks like a clean day on every other dashboard.",
    "editable": false,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum(increase(ehlo_events_total{result=\"invalid\"}[10m])) or vector(0)",
                        "instant": true,
                        "legendFormat": "",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Events ehlo refused in the last 10 minutes because they were malformed. Each one is a gap in the other dashboards. Should be 0.",
          "id": 1,
          "links": [],
          "subtitle": "Malformed, last 10 minutes",
          "title": "Rejected events",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "decimals": 0,
                  "noValue": "No data",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "red",
                        "value": 1
                      }
                    ]
                  },
                  "unit": "short"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto"
              }
            },
            "version": "13.3.1"
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum by (type) (rate(ehlo_events_total{result=\"accepted\"}[$__rate_interval])) * 60",
                        "instant": false,
                        "legendFormat": "{{type}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Events accepted per minute, by type. A type that drops to zero while email keeps going out is a feed that stopped.",
          "id": 2,
          "links": [],
          "subtitle": "A type that drops to zero is a stopped feed",
          "title": "Events received by type",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "drawStyle": "line",
                    "fillOpacity": 60,
                    "lineWidth": 1,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "normal"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "unit": "suffix: /min"
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": "13.3.1"
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "time() - max by (route, type) (max_over_time(ehlo_route_last_event_timestamp_seconds{type=~\"complaint|bounce|open\"}[1d]))",
                        "instant": true,
                        "legendFormat": "{{route}} {{type}}",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Time since the last complaint, bounce and open event for each way of sending. Past 30 minutes while email keeps going out, the feed has probably stopped, and ehlo would read the silence as a clean day.",
          "id": 3,
          "links": [],
          "subtitle": "Past 30 minutes the feed has probably stopped",
          "title": "Time since last event",
          "vizConfig": {
            "group": "bargauge",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "max": 3600,
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "yellow",
                        "value": 1800
                      }
                    ]
                  },
                  "unit": "s"
                },
                "overrides": []
              },
              "options": {
                "displayMode": "basic",
                "orientation": "horizontal",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showUnfilled": true
              }
            },
            "version": "13.3.1"
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "collapse": false,
              "layout": {
                "kind": "RowsLayout",
                "spec": {
                  "rows": [
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "collapse": false,
                        "hideHeader": true,
                        "layout": {
                          "kind": "AutoGridLayout",
                          "spec": {
                            "columnWidth": 200,
                            "columnWidthMode": "custom",
                            "fillScreen": false,
                            "items": [
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-1"
                                  }
                                }
                              }
                            ],
                            "maxColumnCount": 4,
                            "rowHeightMode": "short"
                          }
                        }
                      }
                    },
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "collapse": false,
                        "hideHeader": true,
                        "layout": {
                          "kind": "AutoGridLayout",
                          "spec": {
                            "columnWidth": 360,
                            "columnWidthMode": "custom",
                            "fillScreen": false,
                            "items": [
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-2"
                                  }
                                }
                              },
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-3"
                                  }
                                }
                              }
                            ],
                            "maxColumnCount": 2,
                            "rowHeightMode": "standard"
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "title": "Incoming events"
            }
          }
        ]
      }
    },
    "links": [
      {
        "asDropdown": true,
        "icon": "external link",
        "includeVars": true,
        "keepTime": true,
        "tags": [
          "ehlo"
        ],
        "targetBlank": false,
        "title": "Other dashboards",
        "tooltip": "",
        "type": "dashboards"
      }
    ],
    "preload": false,
    "tags": [
      "smtp",
      "email",
      "ehlo"
    ],
    "timeSettings": {
      "autoRefresh": "30s",
      "autoRefreshIntervals": [
        "30s",
        "1m",
        "5m",
        "15m",
        "1h"
      ],
      "fiscalYearStartMonth": 0,
      "from": "now-3h",
      "hideTimepicker": false,
      "timezone": "utc",
      "to": "now"
    },
    "title": "ehlo / Pipeline",
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "default",
            "value": "default"
          },
          "hide": "dontHide",
          "includeAll": false,
          "label": "Data source",
          "multi": false,
          "name": "datasource",
          "options": [],
          "pluginId": "prometheus",
          "refresh": "onDashboardLoad",
          "regex": "",
          "skipUrlSync": false
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "allValue": ".*",
          "allowCustomValue": true,
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "definition": "label_values(ehlo_smtp_attempts_total{route=\"self_hosted\"}, source)",
          "hide": "dontHide",
          "includeAll": true,
          "label": "Server",
          "multi": true,
          "name": "source",
          "options": [],
          "query": {
            "datasource": {
              "name": "${datasource}"
            },
            "group": "prometheus",
            "kind": "DataQuery",
            "spec": {
              "qryType": 1,
              "query": "label_values(ehlo_smtp_attempts_total{route=\"self_hosted\"}, source)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            },
            "version": "v0"
          },
          "refresh": "onTimeRangeChanged",
          "regex": "",
          "skipUrlSync": false,
          "sort": "naturalAsc"
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "allValue": ".*",
          "allowCustomValue": true,
          "current": {
            "text": [
              "All"
            ],
            "value": [
              "$__all"
            ]
          },
          "definition": "label_values(ehlo_smtp_attempts_total, provider)",
          "hide": "dontHide",
          "includeAll": true,
          "label": "Provider",
          "multi": true,
          "name": "provider",
          "options": [],
          "query": {
            "datasource": {
              "name": "${datasource}"
            },
            "group": "prometheus",
            "kind": "DataQuery",
            "spec": {
              "qryType": 1,
              "query": "label_values(ehlo_smtp_attempts_total, provider)",
              "refId": "PrometheusVariableQueryEditor-VariableQuery"
            },
            "version": "v0"
          },
          "refresh": "onTimeRangeChanged",
          "regex": "",
          "skipUrlSync": false,
          "sort": "naturalAsc"
        }
      }
    ]
  }
}
