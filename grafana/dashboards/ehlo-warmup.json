{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "ehlo-warmup"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "enable": true,
          "hide": false,
          "iconColor": "red",
          "legacyOptions": {
            "expr": "ALERTS{component=\"ehlo\", alertstate=\"firing\", severity!=\"info\"}",
            "step": "15s",
            "textFormat": "{{source}} {{provider}} {{code}}",
            "titleFormat": "{{alertname}}",
            "useValueForTime": false
          },
          "name": "Alerts",
          "query": {
            "datasource": {
              "name": "${datasource}"
            },
            "group": "prometheus",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "How much each server may send to each provider today, and why. A new server starts small and grows each clean day.",
    "editable": false,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "ehlo:lane_quota_used:ratio{source=~\"$source\", provider=~\"$provider\"}",
                        "instant": true,
                        "legendFormat": "{{source}} to {{provider}}",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "One bar per server and provider (a lane). 100% means the server sent everything ehlo allowed today toward that provider, and more mail to it has to go through another server. Expected while a server warms up.",
          "id": 1,
          "links": [],
          "subtitle": "Per server and provider; 100% is the day's limit",
          "title": "Today's sending limit used",
          "vizConfig": {
            "group": "bargauge",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "max": 1,
                  "min": 0,
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "blue",
                        "value": 1
                      }
                    ]
                  },
                  "unit": "percentunit"
                },
                "overrides": []
              },
              "options": {
                "displayMode": "basic",
                "orientation": "horizontal",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showUnfilled": true
              }
            },
            "version": "13.3.1"
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "max by (source, provider) (ehlo_warmup_state{state=\"raising\", source=~\"$source\", provider=~\"$provider\"})\n+ 2 * max by (source, provider) (ehlo_warmup_state{state=\"holding\", source=~\"$source\", provider=~\"$provider\"})\n+ 3 * max by (source, provider) (ehlo_warmup_state{state=\"paused\", source=~\"$source\", provider=~\"$provider\"})\n+ 4 * max by (source, provider) (ehlo_warmup_state{state=\"backoff\", source=~\"$source\", provider=~\"$provider\"})\n+ 5 * max by (source, provider) (ehlo_warmup_state{state=\"blocked\", source=~\"$source\", provider=~\"$provider\"})",
                        "instant": false,
                        "legendFormat": "{{source}} to {{provider}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "One line per server and provider. Growing: the daily limit rises after each clean day. Fully warmed: the server sends its whole target. Holding: the limit stays put after complaints, bounces, low volume or a slowdown. Paused: complaints were too high, no sending for a day. Slowed down: the provider asked to slow down, sending stops for a few minutes. Blocked: the provider blocked the server, sending stops until tomorrow.",
          "id": 2,
          "links": [],
          "subtitle": "What the warmup decided, per server and provider",
          "title": "Warmup status",
          "vizConfig": {
            "group": "state-timeline",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "fixedColor": "text",
                    "mode": "fixed"
                  },
                  "custom": {
                    "fillOpacity": 80,
                    "lineWidth": 0
                  },
                  "mappings": [
                    {
                      "options": {
                        "0": {
                          "color": "green",
                          "index": 0,
                          "text": "Fully warmed"
                        },
                        "1": {
                          "color": "blue",
                          "index": 1,
                          "text": "Growing"
                        },
                        "2": {
                          "color": "yellow",
                          "index": 2,
                          "text": "Holding"
                        },
                        "3": {
                          "color": "red",
                          "index": 3,
                          "text": "Paused"
                        },
                        "4": {
                          "color": "orange",
                          "index": 4,
                          "text": "Slowed down"
                        },
                        "5": {
                          "color": "dark-red",
                          "index": 5,
                          "text": "Blocked"
                        }
                      },
                      "type": "value"
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "text",
                        "value": null
                      }
                    ]
                  },
                  "unit": ""
                },
                "overrides": []
              },
              "options": {
                "alignValue": "left",
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "mergeValues": true,
                "rowHeight": 0.9,
                "showValue": "never",
                "tooltip": {
                  "mode": "single",
                  "sort": "none"
                }
              }
            },
            "version": "13.3.1"
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "max by (source, provider) (ehlo_warmup_hourly_limit_messages{source=~\"$source\", provider=~\"$provider\"})",
                        "instant": false,
                        "legendFormat": "{{source}} to {{provider}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Emails each warming server may send per hour toward each provider. It halves for the rest of the day after the provider asks to slow down. A fully warmed server has no hourly cap and shows its daily limit until a slow-down reply; then it gets the warming cap, halved.",
          "id": 3,
          "links": [],
          "subtitle": "Emails each server may send this hour",
          "title": "Hourly allowance",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 2,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "unit": "short"
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": "13.3.1"
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "max by (source, provider) (ehlo_warmup_backoffs{source=~\"$source\", provider=~\"$provider\"})",
                        "instant": false,
                        "legendFormat": "{{source}} to {{provider}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Times today the provider asked a server to slow down or blocked it. Each one stops tomorrow's growth for that server and provider.",
          "id": 4,
          "links": [],
          "subtitle": "Each one stops tomorrow's growth",
          "title": "Slowdowns today",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 2,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "unit": "short"
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": "13.3.1"
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "max by (source, provider) (ehlo_warmup_complaints_today{source=~\"$source\", provider=~\"$provider\"}) / (max by (source, provider) (ehlo_warmup_delivered_today_messages{source=~\"$source\", provider=~\"$provider\"}) > 0) * 10000",
                        "instant": false,
                        "legendFormat": "{{source}} to {{provider}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Complaints per 10,000 delivered today, as the warmup counts them. At 10 the limit stops growing, at 30 the server pauses toward that provider. The end-of-day decision also uses the previous days.",
          "id": 5,
          "links": [],
          "subtitle": "Growth stops at 10, sending pauses at 30",
          "title": "Spam complaints today",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 2,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "line"
                    }
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "transparent",
                        "value": null
                      },
                      {
                        "color": "yellow",
                        "value": 10
                      },
                      {
                        "color": "red",
                        "value": 30
                      }
                    ]
                  },
                  "unit": "suffix: per 10,000"
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": "13.3.1"
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "max by (source, provider) (ehlo_warmup_daily_limit_messages{source=~\"$source\", provider=~\"$provider\"}) > 0",
                        "instant": false,
                        "legendFormat": "{{source}} to {{provider}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Each server's daily limit toward each provider, on a log scale so a ramp from 50 to 100,000 reads as a straight line. Each provider has its own growth pace.",
          "id": 6,
          "links": [],
          "subtitle": "Log scale: a steady ramp is a straight line",
          "title": "Daily limit growth",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 2,
                    "scaleDistribution": {
                      "log": 10,
                      "type": "log"
                    },
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "unit": "short"
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": "13.3.1"
          }
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "max by (source, provider) (ehlo_warmup_share_ratio{source=~\"$source\", provider=~\"$provider\"})",
                        "instant": false,
                        "legendFormat": "{{source}} to {{provider}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Each server's limit as a share of all limits toward the provider. A router that splits mail by this share fills every server at the same pace.",
          "id": 7,
          "links": [],
          "subtitle": "Each server's part of the provider's limits",
          "title": "Share of provider volume",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 2,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "max": 1,
                  "min": 0,
                  "unit": "percentunit"
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": "13.3.1"
          }
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum by (source) (rate(ehlo_audience_messages_total{audience=\"engaged\", route=\"self_hosted\", source=~\"$source\"}[$__rate_interval]))\n/ sum by (source) (rate(ehlo_audience_messages_total{route=\"self_hosted\", source=~\"$source\"}[$__rate_interval]))",
                        "instant": false,
                        "legendFormat": "{{source}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Share of emails sent to recipients who opened or clicked recently. A warming server should send mostly to them: they rarely complain, which builds reputation.",
          "id": 8,
          "links": [],
          "subtitle": "Recipients who opened or clicked recently",
          "title": "Mail to engaged readers",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 2,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "max": 1,
                  "min": 0,
                  "unit": "percentunit"
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": "13.3.1"
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "collapse": false,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "columnWidth": 360,
                  "columnWidthMode": "custom",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-1"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-2"
                        }
                      }
                    }
                  ],
                  "maxColumnCount": 2,
                  "rowHeightMode": "tall"
                }
              },
              "title": "Today"
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "collapse": false,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "columnWidth": 360,
                  "columnWidthMode": "custom",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-3"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-4"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-5"
                        }
                      }
                    }
                  ],
                  "maxColumnCount": 3,
                  "rowHeightMode": "standard"
                }
              },
              "title": "During the day"
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "collapse": false,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "columnWidth": 360,
                  "columnWidthMode": "custom",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-6"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-7"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-8"
                        }
                      }
                    }
                  ],
                  "maxColumnCount": 3,
                  "rowHeightMode": "standard"
                }
              },
              "title": "Ramp"
            }
          }
        ]
      }
    },
    "links": [
      {
        "asDropdown": true,
        "icon": "external link",
        "includeVars": true,
        "keepTime": true,
        "tags": [
          "ehlo"
        ],
        "targetBlank": false,
        "title": "Other dashboards",
        "tooltip": "",
        "type": "dashboards"
      }
    ],
    "preload": false,
    "tags": [
      "smtp",
      "email",
      "ehlo"
    ],
    "timeSettings": {
      "autoRefresh": "30s",
      "autoRefreshIntervals": [
        "30s",
        "1m",
        "5m",
        "15m",
        "1h"
      ],
      "fiscalYearStartMonth": 0,
      "from": "now-7d",
      "hideTimepicker": false,
      "timezone": "utc",
      "to": "now"
    },
    "title": "ehlo / Warmup",
    "variables": [
      {
        "kind": "DatasourceVariable",
        "spec": {
