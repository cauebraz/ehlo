{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "ehlo-reputation"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "enable": true,
          "hide": false,
          "iconColor": "red",
          "legacyOptions": {
            "expr": "ALERTS{component=\"ehlo\", alertstate=\"firing\", severity!=\"info\"}",
            "step": "15s",
            "textFormat": "{{source}} {{provider}} {{code}}",
            "titleFormat": "{{alertname}}",
            "useValueForTime": false
          },
          "name": "Alerts",
          "query": {
            "datasource": {
              "name": "${datasource}"
            },
            "group": "prometheus",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "How recipients and providers judge the mail: spam complaints, bounces, blocks and sender checks.",
    "editable": false,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum by (provider) (rate(ehlo_complaints_total{route=\"self_hosted\", source=~\"$source\", provider=~\"$provider\"}[$__rate_interval])) / sum by (provider) (rate(ehlo_delivered_total{route=\"self_hosted\", source=~\"$source\", provider=~\"$provider\"}[$__rate_interval])) * 10000",
                        "instant": false,
                        "legendFormat": "{{provider}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Recipients who marked an email as spam, per 10,000 delivered. Lines at 10 and 30: Gmail asks to stay under 10 and never reach 30, and the warmup holds and pauses at the same values.",
          "id": 1,
          "links": [],
          "subtitle": "Per 10,000 delivered; stay under 10, never 30",
          "title": "Complaints by provider",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 2,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "line"
                    }
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "transparent",
                        "value": null
                      },
                      {
                        "color": "yellow",
                        "value": 10
                      },
                      {
                        "color": "red",
                        "value": 30
                      }
                    ]
                  },
                  "unit": "suffix: per 10,000"
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": "13.3.1"
          }
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "ehlo:open:ratio_rate10m",
                        "instant": false,
                        "legendFormat": "{{route}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Opens as a share of delivered emails. It tells whether your own servers keep the engagement an email service gets.",
          "id": 10,
          "links": [],
          "subtitle": "Opens as a share of delivered emails",
          "title": "Open rate",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 2,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "unit": "percentunit"
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": "13.3.1"
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum by (source) (increase(ehlo_complaints_total{route=\"self_hosted\", source=~\"$source\", provider=~\"$provider\"}[1h]))",
                        "instant": false,
                        "legendFormat": "{{source}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Complaints per hour for each server. One server rising alone points at what it carried. All of them rising points at the content or the list.",
          "id": 2,
          "links": [],
          "subtitle": "One server rising alone points at its mail",
          "title": "Complaints per server",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 2,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "unit": "suffix: /hour"
                },
                "overrides": []
              },
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "desc"
                }
              }
            },
            "version": "13.3.1"
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum by (route, kind) (rate(ehlo_bounces_total{route=\"self_hosted\", source=~\"$source\", provider=~\"$provider\"}[$__rate_interval]))\n/ ignoring (kind) group_left sum by (route) (rate(ehlo_smtp_attempts_total{route=\"self_hosted\", source=~\"$source\", provider=~\"$provider\", attempt=\"first\"}[$__rate_interval]))",
                        "instant": false,
                        "legendFormat": "{{kind}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Bounces as a share of emails sent. hard: the address does not exist; remove it from the list. soft: a temporary problem that lasted too long. policy: the provider refused the sender, not the address.",
          "id": 3,
          "links": [],
          "subtitle": "Share of emails sent: hard, soft, policy",
          "title": "Bounces by kind",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineWidth": 2,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                      "mode": "off"
                    }
                  },
                  "unit": "percentunit"
                },
                "overrides": []
