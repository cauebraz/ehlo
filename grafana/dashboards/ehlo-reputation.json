                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "sum by (provider, category) (rate(ehlo_reply_categories_total{route=\"self_hosted\", source=~\"$source\", provider=~\"$provider\", category=~\"auth_failure|reputation_block\"}[$__rate_interval])) * 60",
                        "instant": false,
                        "legendFormat": "{{provider}} {{category}}",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Emails refused per minute because the provider distrusts the server (reputation_block: Microsoft S3150, Yahoo TSS11, 5.7.511) or could not confirm the email comes from your domain (auth_failure: SPF, DKIM or DMARC; Outlook 5.7.515, Gmail 5.7.26). Both are about the sender, never the recipient.",
          "id": 4,
          "links": [],
          "subtitle": "Blocked reputation or failed sender checks",
          "title": "Rejected: reputation or sender checks",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
