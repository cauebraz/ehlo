    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "collapse": false,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "columnWidth": 360,
                  "columnWidthMode": "custom",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
